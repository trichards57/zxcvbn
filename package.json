{
  "name": "zxcvbn-typescript",
  "version": "6.0.0-beta.1",
  "description": "realistic password strength estimation, updated and ported to Typescript from Dan Wheeler's zxcvbn",
  "author": "Tony Richards",
  "license": "MIT",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/trichards57/zxcvbn.git"
  },
  "bugs": "https://github.com/trichards57/zxcvbn/issues",
  "contributors": [
    {
      "name": "Dan Wheeler"
    }
  ],
  "scripts": {
    "test": "vitest --globals",
    "build": "tsdown --minify",
    "check": "biome check",
    "check:fix": "biome check --write",
    "prepublishOnly": "npm run build"
  },
  "devDependencies": {
    "@biomejs/biome": "2.3.11",
    "publint": "^0.3.16",
    "tsdown": "^0.19.0-beta.3",
    "typescript": "^5.9.3",
    "vitest": "^4.0.16"
  },
  "type": "module",
  "keywords": [
    "password",
    "passphrase",
    "security",
    "authentication",
    "strength",
    "meter",
    "quality",
    "estimation",
    "pattern",
    "cracking",
    "scoring",
    "entropy",
    "bruteforce"
  ],
  "config": {
    "commitizen": {
      "path": "./node_modules/cz-conventional-changelog"
    }
  },
  "browserslist": [
    "baseline widely available"
  ],
  "exports": {
    ".": "./dist/index.js",
    "./package.json": "./package.json",
    "./async": "./dist/async/index.js"
  }
}
