root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

[*.{ts,js,mts,cts,mjs,cjs}]
max_line_length = 80

[*.json]
max_line_length = 80

[*.{yml,yaml}]
max_line_length = 80

[*.md]
trim_trailing_whitespace = false
max_line_length = 80

[*.html]
max_line_length = 80

[*.py]
max_line_length = 88
